<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro
    name="amr_sensors"
    params="lidar_xyz lidar_rpy camera_xyz camera_rpy imu_xyz imu_rpy laser_lower laser_upper laser_effort laser_velocity laser_damping camera_lower camera_upper camera_effort camera_velocity camera_damping">
    <!-- The measured LiDAR position is represented by an immutable mounting frame. -->
    <joint name="laser_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="laser_mount_link"/>
      <origin xyz="${lidar_xyz}" rpy="${lidar_rpy}"/>
    </joint>
    <link name="laser_mount_link"/>

    <!--
      laser_link is the fixed virtual frame used by the assembled LaserScan message.
      Keeping it fixed prevents the servo angle from being applied twice to scan points.
    -->
    <joint name="laser_scan_frame_joint" type="fixed">
      <parent link="laser_mount_link"/>
      <child link="laser_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="laser_link"/>

    <!-- laser_servo_link represents the physical instantaneous sensor orientation. -->
    <joint name="laser_servo_joint" type="revolute">
      <parent link="laser_mount_link"/>
      <child link="laser_servo_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit
        lower="${laser_lower}"
        upper="${laser_upper}"
        effort="${laser_effort}"
        velocity="${laser_velocity}"/>
      <dynamics damping="${laser_damping}" friction="0.0"/>
    </joint>
    <link name="laser_servo_link"/>

    <joint name="laser_sensor_joint" type="fixed">
      <parent link="laser_servo_link"/>
      <child link="laser_sensor_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="laser_sensor_link"/>

    <!-- The camera tilt origin is the measured optical assembly mounting position. -->
    <joint name="camera_tilt_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_tilt_mount_link"/>
      <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
    </joint>
    <link name="camera_tilt_mount_link"/>

    <!-- Positive rotation about +Y pitches the forward camera axis toward the floor. -->
    <joint name="camera_tilt_joint" type="revolute">
      <parent link="camera_tilt_mount_link"/>
      <child link="camera_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit
        lower="${camera_lower}"
        upper="${camera_upper}"
        effort="${camera_effort}"
        velocity="${camera_velocity}"/>
      <dynamics damping="${camera_damping}" friction="0.0"/>
    </joint>
    <link name="camera_link"/>

    <!-- REP-103 optical convention: +Z forward, +X right, and +Y down. -->
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2.0} 0 ${-pi / 2.0}"/>
    </joint>
    <link name="camera_optical_frame"/>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${imu_xyz}" rpy="${imu_rpy}"/>
    </joint>
    <link name="imu_link"/>
  </xacro:macro>
</robot>
